    const bufferingNotice = document.getElementById('bufferingNotice');
    const debugErrorText = document.getElementById('debugErrorText');
    const toggleDirectBtn = document.getElementById('toggleDirectBtn');
    const switchFallbackBtn = document.getElementById('switchFallbackBtn');
    const retryPlayBtn = document.getElementById('retryPlayBtn');
    const sleepTimerSelect = document.getElementById('sleepTimerSelect');
    const sleepTimerNotice = document.getElementById('sleepTimerNotice');
    const sleepTimerCountdown = document.getElementById('sleepTimerCountdown');
    const playerEpgCurrentTitle = document.getElementById('playerEpgCurrentTitle');
    const playerEpgTimeRange = document.getElementById('playerEpgTimeRange');
