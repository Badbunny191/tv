    const savedVolume = localStorage.getItem(VOLUME_KEY);
    if (savedVolume !== null) {
      videoPlayer.volume = parseFloat(savedVolume);
    }
    videoPlayer.addEventListener('volumechange', () => {
      localStorage.setItem(VOLUME_KEY, videoPlayer.volume.toString());
    });

    function showSkeletons() {
      channelsGrid.innerHTML = '';
      for (let i = 0; i < 12; i++) {
        const skeleton = document.createElement('div');
        skeleton.className = 'bg-gray-900 border border-gray-800 rounded-xl p-3 flex flex-col items-center animate-pulse';
        skeleton.innerHTML = `
          <div class="w-full aspect-[4/3] bg-gray-800 rounded-lg mb-3"></div>
          <div class="w-3/4 h-3 bg-gray-800 rounded mb-2"></div>
          <div class="w-1/2 h-2 bg-gray-800 rounded mb-2"></div>
          <div class="w-full h-1.5 bg-gray-800 rounded mt-1"></div>
        `;
        channelsGrid.appendChild(skeleton);
      }
    }

    async function fetchPlaylist() {
      showSkeletons();
      errorAlert.classList.add('hidden');
      emptyStatus.classList.add('hidden');

      let textData = null;

      try {
        const res = await fetch(PRIMARY_M3U, { cache: 'no-cache' });
        if (res.ok) textData = await res.text();
      } catch (err) {
        console.warn('Direct primary fetch failed:', err);
      }

      if (!textData) {
        try {
          const resProxy = await fetch(`/proxy?url=${encodeURIComponent(PRIMARY_M3U)}`);
          if (resProxy.ok) textData = await resProxy.text();
        } catch (proxyErr) {
          console.error('Proxy primary fetch failed:', proxyErr);
        }
      }

      if (textData) {
        channels = parseM3U(textData);
        renderCategories();
        renderChannels();
        loadFallbackM3ULists();
        fetchEPGData();
      } else {
        channelsGrid.innerHTML = '';
        errorMessage.textContent = 'ไม่สามารถดึงไฟล์ M3U จาก GitHub ได้';
        errorAlert.classList.remove('hidden');
      }
    }

    function normalizeChannelName(rawName) {
      return rawName
        .toLowerCase()
        .replace(/\(1080p\)|\(720p\)|\(576p\)|\(hd\)/g, '')
        .replace(/[^a-z0-9]/g, '')
        .trim();
    }

    function parseM3U(m3uContent) {
      const parsedChannels = [];
      const lines = m3uContent.split(/\r?\n/);
      let currentInfo = null;

      for (let i = 0; i < lines.length; i++) {
        const line = lines[i].trim();

        if (line.startsWith('#EXTINF:')) {
          const nameMatch = line.match(/,(.+)$/);
          const logoMatch = line.match(/tvg-logo="([^"]+)"/);
          const groupMatch = line.match(/group-title="([^"]+)"/);
          const idMatch = line.match(/tvg-id="([^"]+)"/);

          const rawName = nameMatch ? nameMatch[1].trim() : 'ไม่มีชื่อช่อง';
          const normKey = normalizeChannelName(rawName);
          const assignedNum = OFFICIAL_CHANNEL_NUMBERS[normKey] || (parsedChannels.length + 1);

          currentInfo = {
            id: idMatch ? idMatch[1].trim() : '',
            name: rawName,
            channelNumber: assignedNum,
            logo: logoMatch ? logoMatch[1] : '',
            group: groupMatch ? groupMatch[1].trim() : 'ทั่วไป',
            url: ''
          };
        } else if (line.startsWith('http://') || line.startsWith('https://')) {
          if (currentInfo) {
            currentInfo.url = line;
            parsedChannels.push(currentInfo);
            currentInfo = null;
          }
        }
      }
      return parsedChannels;
    }

    async function loadFallbackM3ULists() {
      const fallbackIndexes = [1, 2, 3, 6, 12, 13, 14, 16, 17];
      for (const idx of fallbackIndexes) {
        try {
          const url = `${FALLBACK_M3U_BASE}${idx}.m3u`;
          const res = await fetch(url);
          if (!res.ok) continue;
          const text = await res.text();
          const items = parseM3U(text);
          items.forEach(item => {
            const list = fallbackSourcesMap.get(item.name) || [];
            if (!list.includes(item.url)) {
              list.push(item.url);
              fallbackSourcesMap.set(item.name, list);
            }
          });
        } catch (e) {}
      }
    }

    async function fetchEPGData() {
      try {
        let xmlText = null;
        try {
          const res = await fetch(EPG_XML_URL);
          if (res.ok) xmlText = await res.text();
        } catch (e) {
          const resProxy = await fetch(`/proxy?url=${encodeURIComponent(EPG_XML_URL)}`);
          if (resProxy.ok) xmlText = await resProxy.text();
        }

        if (!xmlText) return;

        const parser = new DOMParser();
        const xmlDoc = parser.parseFromString(xmlText, "text/xml");
        const programmes = xmlDoc.getElementsByTagName("programme");

        epgProgrammes.clear();

        for (let i = 0; i < programmes.length; i++) {
          const prog = programmes[i];
          const channelId = prog.getAttribute("channel");
          const startStr = prog.getAttribute("start");
          const stopStr = prog.getAttribute("stop");
          const titleElem = prog.getElementsByTagName("title")[0];
          const title = titleElem ? titleElem.textContent : "รายการสด";

          if (channelId && startStr && stopStr) {
            const start = parseXMLTVDate(startStr);
            const stop = parseXMLTVDate(stopStr);

            const list = epgProgrammes.get(channelId.toLowerCase()) || [];
            list.push({ title, start, stop });
            epgProgrammes.set(channelId.toLowerCase(), list);
          }
        }

        renderChannels();
      } catch (err) {
        console.warn("EPG Load Notice:", err);
      }
    }

    function parseXMLTVDate(str) {
      const year = parseInt(str.substring(0, 4), 10);
      const month = parseInt(str.substring(4, 6), 10) - 1;
      const day = parseInt(str.substring(6, 8), 10);
      const hour = parseInt(str.substring(8, 10), 10);
      const min = parseInt(str.substring(10, 12), 10);
      const sec = parseInt(str.substring(12, 14), 10);
      return new Date(Date.UTC(year, month, day, hour - 7, min, sec)).getTime();
    }

    function getCurrentEPG(channel) {
      const now = Date.now();
      const rawKey = normalizeChannelName(channel.name);
      const matchedKey = EPG_ALIAS_MAP[rawKey] || rawKey;

      let list = epgProgrammes.get(matchedKey);
      
      if (!list) {
        for (const [key, programmes] of epgProgrammes.entries()) {
          if (key.includes(matchedKey) || matchedKey.includes(key)) {
            list = programmes;
            break;
          }
        }
      }

      if (list && list.length > 0) {
        const current = list.find(p => now >= p.start && now < p.stop);
        if (current) {
          const total = current.stop - current.start;
          const elapsed = now - current.start;
          const progress = Math.min(100, Math.max(0, (elapsed / total) * 100));

          const formatTime = (t) => {
            const d = new Date(t);
            return `${d.getHours().toString().padStart(2, '0')}:${d.getMinutes().toString().padStart(2, '0')}`;
          };

          return {
            title: current.title,
            timeRange: `${formatTime(current.start)} - ${formatTime(current.stop)}`,
            progress: progress
          };
        }
      }

      const currentMinute = new Date().getMinutes();
      const cleanName = channel.name.replace(/\(.*\)/, '').trim();
      return {
        title: `กำลังออกอากาศสด (${cleanName})`,
        timeRange: "Live",
        progress: ((currentMinute % 30) / 30) * 100
      };
    }

    function toggleFavorite(channelName, e) {
      if (e) e.stopPropagation();
      const index = favorites.indexOf(channelName);
      if (index === -1) {
        favorites.push(channelName);
      } else {
        favorites.splice(index, 1);
      }
      localStorage.setItem(FAVORITES_KEY, JSON.stringify(favorites));
      updateFavIcons();
      if (activeCategory === 'FAVORITES') {
        renderChannels();
      }
    }

    function addToHistory(channel) {
      history = history.filter(item => item.name !== channel.name);
      history.unshift({ 
        name: channel.name, 
        logo: channel.logo, 
        group: channel.group, 
        url: channel.url, 
        id: channel.id,
        channelNumber: channel.channelNumber 
      });
      if (history.length > 25) history.pop();
      localStorage.setItem(HISTORY_KEY, JSON.stringify(history));
    }

    function updateFavIcons() {
      document.querySelectorAll('[data-fav-target]').forEach(btn => {
        const name = btn.dataset.favTarget;
        const isFav = favorites.includes(name);
        btn.innerHTML = `<i class="fa-${isFav ? 'solid text-amber-400' : 'regular text-gray-400'} fa-star"></i>`;
      });
      if (currentChannelData) {
        const isFav = favorites.includes(currentChannelData.name);
        modalFavBtn.innerHTML = `<i class="fa-${isFav ? 'solid text-amber-400' : 'regular text-gray-400'} fa-star"></i>`;
      }
    }

    function renderCategories() {
      const standardGroups = [...new Set(channels.map(c => c.group).filter(Boolean))];
      const categories = [
        { id: 'ALL', label: 'ทั้งหมด' },
        { id: 'FAVORITES', label: '⭐ รายการโปรด' },
        { id: 'HISTORY', label: '🕒 ดูก่อนหน้า' },
        ...standardGroups.map(g => ({ id: g, label: g }))
      ];

      categoryContainer.innerHTML = '';

      categories.forEach(cat => {
        const btn = document.createElement('button');
        const isActive = activeCategory === cat.id;
        btn.className = `category-btn px-4 py-1.5 rounded-full text-xs font-medium whitespace-nowrap transition ${
          isActive 
            ? 'bg-rose-600 text-white shadow-sm' 
            : 'bg-gray-800 text-gray-300 hover:bg-gray-700'
        }`;
        btn.textContent = cat.label;
        btn.dataset.category = cat.id;

        btn.addEventListener('click', () => {
          activeCategory = cat.id;
          document.querySelectorAll('.category-btn').forEach(b => {
            b.className = 'category-btn px-4 py-1.5 rounded-full text-xs font-medium whitespace-nowrap transition bg-gray-800 text-gray-300 hover:bg-gray-700';
          });
          btn.className = 'category-btn px-4 py-1.5 rounded-full text-xs font-medium whitespace-nowrap transition bg-rose-600 text-white shadow-sm';
          renderChannels();
        });

        categoryContainer.appendChild(btn);
      });
    }

    function renderChannels() {
      const searchTerm = searchInput.value.toLowerCase().trim();
      let sourceList = channels;

      if (activeCategory === 'FAVORITES') {
        sourceList = channels.filter(c => favorites.includes(c.name));
      } else if (activeCategory === 'HISTORY') {
        sourceList = history;
      }

      const filtered = sourceList.filter(c => {
        const matchesCategory = activeCategory === 'ALL' || activeCategory === 'FAVORITES' || activeCategory === 'HISTORY' || c.group === activeCategory;
        const matchesSearch = c.name.toLowerCase().includes(searchTerm) || c.channelNumber.toString() === searchTerm;
        return matchesCategory && matchesSearch;
      });

      channelsGrid.innerHTML = '';
      focusedCardIndex = -1;

      if (filtered.length === 0) {
        emptyStatus.classList.remove('hidden');
        return;
      }
      emptyStatus.classList.add('hidden');

      filtered.forEach((ch, idx) => {
        const card = document.createElement('div');
        card.tabIndex = 0;
        card.className = 'channel-card group relative bg-gray-900 border border-gray-800 hover:border-rose-500/60 rounded-xl p-3 flex flex-col justify-between cursor-pointer transition duration-200 transform';
        card.dataset.index = idx;
        card.dataset.channelNumber = ch.channelNumber;

        const fallbackImg = `https://placehold.co/120x80/1f2937/9ca3af?text=${encodeURIComponent(ch.name.slice(0, 4))}`;
        const logoSrc = ch.logo || fallbackImg;
        const isFav = favorites.includes(ch.name);
        const epg = getCurrentEPG(ch);

        card.innerHTML = `
          <div class="absolute top-2 left-2 px-1.5 py-0.5 rounded bg-gray-950/80 border border-gray-700 text-[10px] font-black text-rose-400 z-10 font-mono">
            ${ch.channelNumber}
          </div>

          <button class="absolute top-2 right-2 p-1.5 rounded-full bg-gray-950/70 hover:bg-gray-800 transition z-10" data-fav-target="${ch.name}">
            <i class="fa-${isFav ? 'solid text-amber-400' : 'regular text-gray-400'} fa-star"></i>
          </button>

          <div class="w-full aspect-[4/3] bg-gray-950 rounded-lg flex items-center justify-center p-3 mb-2 overflow-hidden">
            <img 
              src="${logoSrc}" 
              alt="${ch.name}" 
              class="max-h-full max-w-full object-contain group-hover:scale-105 transition duration-300"
              onerror="this.src='${fallbackImg}'"
              loading="lazy"
            >
          </div>
          <div class="w-full">
            <div class="flex items-center justify-between gap-1 mb-1">
              <span class="text-xs font-semibold text-gray-200 group-hover:text-rose-400 truncate" title="${ch.name}">
                ${ch.name}
              </span>
              <span class="inline-block text-[9px] bg-gray-800 text-gray-400 px-1.5 py-0.2 rounded shrink-0">
                ${ch.group}
              </span>
            </div>

            <div class="text-[11px] text-gray-300 truncate mb-1.5" title="${epg.title}">
              <i class="fa-solid fa-play text-[8px] text-rose-500 mr-1"></i>${epg.title}
            </div>
            
            <div class="w-full bg-gray-800 h-1 rounded-full overflow-hidden">
              <div class="bg-rose-500 h-full rounded-full" style="width: ${epg.progress}%"></div>
            </div>
          </div>
        `;

        const favBtn = card.querySelector(`[data-fav-target="${ch.name}"]`);
        favBtn.addEventListener('click', (e) => toggleFavorite(ch.name, e));

        card.addEventListener('click', () => openPlayer(ch));
        channelsGrid.appendChild(card);
      });
    }

    function openPlayer(channel) {
      currentChannelData = channel;
      isDirectMode = true;

      const fallbacks = fallbackSourcesMap.get(channel.name) || [];
      currentStreamsList = [channel.url, ...fallbacks.filter(u => u !== channel.url)];
      currentStreamIndex = 0;

      currentChannelName.textContent = channel.name;
      currentChannelGroup.textContent = channel.group;
      currentChannelNumBadge.textContent = `CH ${channel.channelNumber}`;
      currentChannelLogo.src = channel.logo || `https://placehold.co/40x40/1f2937/9ca3af?text=TV`;
      sourceBadge.textContent = `Source 1/${currentStreamsList.length}`;
      
      const epg = getCurrentEPG(channel);
      playerEpgCurrentTitle.textContent = epg.title;
      playerEpgTimeRange.textContent = epg.timeRange;
      playerEpgProgressBar.style.width = `${epg.progress}%`;

      toggleDirectBtn.textContent = 'ผ่าน Proxy';
      playerErrorOverlay.classList.add('hidden');
      updateFavIcons();
      addToHistory(channel);
      playerModal.classList.remove('hidden');

      initiatePlayback();
    }

    function initiatePlayback() {
      const activeUrl = currentStreamsList[currentStreamIndex];
      sourceBadge.textContent = `Source ${currentStreamIndex + 1}/${currentStreamsList.length}`;

      const playUrl = isDirectMode 
        ? activeUrl 
        : `/proxy?url=${encodeURIComponent(activeUrl)}`;

      bufferingNotice.textContent = `กำลังโหลด Source ${currentStreamIndex + 1}...`;
      playStream(playUrl);
    }

    function playStream(url) {
      playerErrorOverlay.classList.add('hidden');
      playerBuffering.classList.remove('hidden');
      qualitySelect.classList.add('hidden');
      qualitySelect.innerHTML = '<option value="-1">Auto (HD)</option>';
      audioTrackSelect.classList.add('hidden');
      audioTrackSelect.innerHTML = '<option value="-1">🔊 เสียงหลัก</option>';

      if (hlsInstance) {
        hlsInstance.destroy();
        hlsInstance = null;
      }

      if (Hls.isSupported()) {
        hlsInstance = new Hls({
          enableWorker: true,
          lowLatencyMode: true,
          manifestLoadingTimeOut: 15000,
          manifestLoadingMaxRetry: 3,
          startLevel: -1
        });

        hlsInstance.loadSource(url);
        hlsInstance.attachMedia(videoPlayer);

        hlsInstance.on(Hls.Events.MANIFEST_PARSED, (event, data) => {
          playerBuffering.classList.add('hidden');

          if (hlsInstance.levels.length > 0) {
            qualitySelect.classList.remove('hidden');
            hlsInstance.levels.forEach((level, index) => {
              const opt = document.createElement('option');
              opt.value = index;
              if (level.height && level.height > 0) {
                opt.textContent = `${level.height}p`;
              } else if (level.bitrate) {
                opt.textContent = `${Math.round(level.bitrate / 1000)}k`;
              } else {
                opt.textContent = `Source ${index + 1}`;
              }
              qualitySelect.appendChild(opt);
            });

            const maxIdx = hlsInstance.levels.length - 1;
            hlsInstance.currentLevel = maxIdx;
            qualitySelect.value = maxIdx;
          }

          if (hlsInstance.audioTracks && hlsInstance.audioTracks.length > 1) {
            audioTrackSelect.classList.remove('hidden');
            audioTrackSelect.innerHTML = '';
            hlsInstance.audioTracks.forEach((track, index) => {
              const opt = document.createElement('option');
              opt.value = index;
              opt.textContent = `🔊 ${track.name || `Track ${index + 1}`}`;
              if (index === hlsInstance.audioTrack) opt.selected = true;
              audioTrackSelect.appendChild(opt);
            });
          }

          videoPlayer.play().catch(e => console.log('Autoplay handled:', e));
        });

        hlsInstance.on(Hls.Events.ERROR, (event, data) => {
          if (data.fatal) {
            console.error('Fatal HLS Error:', data);
            handlePlaybackFailure(data.details);
          }
        });
      } else if (videoPlayer.canPlayType('application/vnd.apple.mpegurl')) {
        videoPlayer.src = url;
        videoPlayer.addEventListener('loadedmetadata', () => {
          playerBuffering.classList.add('hidden');
          videoPlayer.play().catch(e => console.log('Autoplay handled:', e));
        });
        videoPlayer.addEventListener('error', () => {
          handlePlaybackFailure('Native HLS error');
        });
      } else {
        playerBuffering.classList.add('hidden');
        debugErrorText.textContent = 'เบราว์เซอร์นี้ไม่รองรับการเล่น HLS';
        playerErrorOverlay.classList.remove('hidden');
      }
    }

    function handlePlaybackFailure(errorDetail) {
      if (isDirectMode) {
        console.warn('Direct stream failed, trying Proxy...');
        isDirectMode = false;
        toggleDirectBtn.textContent = 'เล่นตรง';
        initiatePlayback();
        return;
      }

      if (currentStreamIndex < currentStreamsList.length - 1) {
        console.warn('Switching to next fallback source...');
        currentStreamIndex++;
        isDirectMode = true;
        toggleDirectBtn.textContent = 'ผ่าน Proxy';
        initiatePlayback();
        return;
      }

      playerBuffering.classList.add('hidden');
      debugErrorText.textContent = `ข้อผิดพลาด: ${errorDetail} (ลองครบ ${currentStreamsList.length} แหล่งแล้ว)`;
      playerErrorOverlay.classList.remove('hidden');
    }

    function closePlayer() {
      playerModal.classList.add('hidden');
      clearSleepTimer();
      if (document.pictureInPictureElement) {
        document.exitPictureInPicture().catch(() => {});
      }
      if (hlsInstance) {
        hlsInstance.destroy();
        hlsInstance = null;
      }
      videoPlayer.pause();
      videoPlayer.src = '';
    }

    // Toggle Play/Pause on Video Tap
    videoOverlayPlayBtn.addEventListener('click', () => {
      if (videoPlayer.paused) {
        videoPlayer.play();
        playPauseIcon.className = 'fa-solid fa-circle-play text-5xl drop-shadow-lg opacity-80';
      } else {
        videoPlayer.pause();
        playPauseIcon.className = 'fa-solid fa-circle-pause text-5xl drop-shadow-lg opacity-80';
      }
      setTimeout(() => {
        playPauseIcon.classList.add('opacity-0');
      }, 500);
    });

    // Close Button Direct Click
    closeModalBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      closePlayer();
    });

    // Backdrop Click
    playerModal.addEventListener('click', (e) => {
      if (e.target === playerModal) {
        closePlayer();
      }
    });

    fullscreenBtn.addEventListener('click', () => {
      if (videoPlayer.requestFullscreen) {
        videoPlayer.requestFullscreen();
      } else if (videoPlayer.webkitEnterFullscreen) {
        videoPlayer.webkitEnterFullscreen(); // For iOS Safari
      }
    });

    function setSleepTimer(minutes) {
      clearSleepTimer();
      if (minutes <= 0) return;

      sleepTimerTargetTime = Date.now() + minutes * 60 * 1000;
      sleepTimerNotice.classList.remove('hidden');

      sleepTimerInterval = setInterval(() => {
        const remaining = Math.max(0, sleepTimerTargetTime - Date.now());
        const min = Math.floor(remaining / 60000);
        const sec = Math.floor((remaining % 60000) / 1000);
        sleepTimerCountdown.textContent = `${min.toString().padStart(2, '0')}:${sec.toString().padStart(2, '0')}`;

        if (remaining <= 0) {
          clearSleepTimer();
          closePlayer();
        }
      }, 1000);
    }

    function clearSleepTimer() {
      if (sleepTimerInterval) clearInterval(sleepTimerInterval);
      if (sleepTimerTimeout) clearTimeout(sleepTimerTimeout);
      sleepTimerInterval = null;
      sleepTimerTimeout = null;
      sleepTimerNotice.classList.add('hidden');
      sleepTimerSelect.value = "0";
    }

    sleepTimerSelect.addEventListener('change', (e) => {
      setSleepTimer(parseInt(e.target.value, 10));
    });

    qualitySelect.addEventListener('change', (e) => {
      if (hlsInstance) {
        hlsInstance.currentLevel = parseInt(e.target.value, 10);
      }
    });

    audioTrackSelect.addEventListener('change', (e) => {
      if (hlsInstance) {
        hlsInstance.audioTrack = parseInt(e.target.value, 10);
      }
    });

    pipBtn.addEventListener('click', async () => {
      try {
        if (videoPlayer !== document.pictureInPictureElement) {
          await videoPlayer.requestPictureInPicture();
        } else {
          await document.exitPictureInPicture();
        }
      } catch (err) {
        console.error('PiP Error:', err);
      }
    });

    modalFavBtn.addEventListener('click', () => {
      if (currentChannelData) {
        toggleFavorite(currentChannelData.name);
      }
    });

    searchInput.addEventListener('input', () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(renderChannels, 250);
    });

    // Remote Keypad & D-Pad Keyboard Navigation
    document.addEventListener('keydown', (e) => {
      if (document.activeElement === searchInput) {
        if (e.key === 'ArrowDown') {
          searchInput.blur();
          focusCard(0);
        }
        return;
      }

      if (/^[0-9]$/.test(e.key)) {
        e.preventDefault();
        typedNumberBuffer += e.key;
        typedChannelNumber.textContent = typedNumberBuffer;
        channelNumberOverlay.classList.remove('hidden');

        clearTimeout(keypadTimeout);
        keypadTimeout = setTimeout(() => {
          const num = parseInt(typedNumberBuffer, 10);
          typedNumberBuffer = '';
          channelNumberOverlay.classList.add('hidden');

          const targetChannel = channels.find(c => c.channelNumber === num);
          if (targetChannel) {
            openPlayer(targetChannel);
          }
        }, 1200);
        return;
      }

      const cards = document.querySelectorAll('.channel-card');
      if (cards.length === 0) return;

      if (!playerModal.classList.contains('hidden')) {
        if (e.key === 'Escape' || e.key === 'Back' || e.code === 'BrowserBack') {
          closePlayer();
        } else if (e.code === 'Space') {
          e.preventDefault();
          videoPlayer.paused ? videoPlayer.play() : videoPlayer.pause();
        } else if (e.key === 'f' || e.key === 'F') {
          e.preventDefault();
          if (videoPlayer.requestFullscreen) {
            videoPlayer.requestFullscreen();
          } else if (videoPlayer.webkitEnterFullscreen) {
            videoPlayer.webkitEnterFullscreen();
          }
        }
        return;
      }

      const cols = getGridColumnCount();
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        focusCard(Math.min(cards.length - 1, focusedCardIndex + 1));
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        focusCard(Math.max(0, focusedCardIndex - 1));
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (focusedCardIndex + cols < cards.length) {
          focusCard(focusedCardIndex + cols);
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (focusedCardIndex - cols >= 0) {
          focusCard(focusedCardIndex - cols);
        } else {
          focusedCardIndex = -1;
          document.querySelectorAll('.channel-card').forEach(c => c.classList.remove('tv-focused'));
          searchInput.focus();
        }
      } else if (e.key === 'Enter') {
        if (focusedCardIndex >= 0 && cards[focusedCardIndex]) {
          cards[focusedCardIndex].click();
        }
      }
    });

    function getGridColumnCount() {
      const width = window.innerWidth;
      if (width >= 1280) return 6;
      if (width >= 1024) return 5;
      if (width >= 768) return 4;
      if (width >= 640) return 3;
      return 2;
    }

    function focusCard(index) {
      const cards = document.querySelectorAll('.channel-card');
      if (!cards[index]) return;

      cards.forEach(c => c.classList.remove('tv-focused'));
      focusedCardIndex = index;
      cards[index].classList.add('tv-focused');
      cards[index].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    refreshBtn.addEventListener('click', fetchPlaylist);
    mobileRefreshBtn.addEventListener('click', fetchPlaylist);

    toggleDirectBtn.addEventListener('click', () => {
      isDirectMode = !isDirectMode;
      toggleDirectBtn.textContent = isDirectMode ? 'ผ่าน Proxy' : 'เล่นตรง';
      initiatePlayback();
    });

    switchFallbackBtn.addEventListener('click', () => {
      currentStreamIndex = (currentStreamIndex + 1) % currentStreamsList.length;
      isDirectMode = true;
      initiatePlayback();
    });

    retryPlayBtn.addEventListener('click', initiatePlayback);

    fetchPlaylist();
  </script>
</body>
</html>