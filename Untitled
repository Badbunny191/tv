  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW registration failed:', err));
      });
    }

    const PRIMARY_M3U = 'https://raw.githubusercontent.com/Soponwit19997/IPTV/main/Digital_TV.m3u';
    const FALLBACK_M3U_BASE = 'https://raw.githubusercontent.com/Soponwit19997/IPTV/main/Thai%20Digital%20TV';
    const EPG_XML_URL = 'https://raw.githubusercontent.com/tvepg/epg/master/th.xml';

    const OFFICIAL_CHANNEL_NUMBERS = {
      '3hd': 33,
      'ch3': 33,
      'channel3': 33,
      'channel5': 5,
      'ch5': 5,
      'ch7': 35,
      'channel7': 35,
      'ch7hd': 35,
      'mcothd': 30,
      'mcot': 30,
      'ch9': 30,
      'nbthd': 2,
      'nbt': 2,
      'thaipbshd': 3,
      'thaipbs': 3,
      'tsports7': 7,
      'tptv': 10,
      'tnn16': 16,
      'one31': 31,
      'gmm25': 25,
      'thairathtv': 32,
      'amarintv': 34,
      'workpoint': 23,
      'nationtv': 22,
      'pptv': 36
    };

    const EPG_ALIAS_MAP = {
      '3hd': 'ch3hd',
      'ch3': 'ch3hd',
      'channel3': 'ch3hd',
      'channel5': 'tv5hd',
      'ch5': 'tv5hd',
      'ch7': 'ch7hd',
      'channel7': 'ch7hd',
      'ch7hd': 'ch7hd',
      'mcothd': 'mcothd',
      'mcot': 'mcothd',
      'ch9': 'mcothd',
      'nbthd': 'nbthd',
      'nbt': 'nbthd',
      'thaipbshd': 'thaipbshd',
      'thaipbs': 'thaipbshd',
      'tsports7': 'tsports7',
      'tptv': 'tptv',
      'nbt11central': 'nbt11',
      'tnn16': 'tnn16',
      'one31': 'one31',
      'gmm25': 'gmm25',
      'thairathtv': 'thairathtv',
      'amarintv': 'amarintv',
      'workpoint': 'workpoint'
    };

    let channels = [];
    let fallbackSourcesMap = new Map();
    let epgProgrammes = new Map();
    let activeCategory = 'ALL';
    let currentChannelData = null;
    let currentStreamIndex = 0;
    let currentStreamsList = [];
    let isDirectMode = true;
    let hlsInstance = null;
    let focusedCardIndex = -1;
    let searchTimeout = null;

    let typedNumberBuffer = '';
    let keypadTimeout = null;

